# Copier ce fichier en .env.surface (ou .env.deep) et le compléter.
# Les fichiers .env.* sont ignorés par Git, sauf celui-ci.

# Mode de l'application : surface (portes ouvertes) ou deep. Voir docs/DECISIONS.md, D10.
APP_MODE=surface

# Clés des sources (facultatives : une source sans sa clé est sautée ou limitée).
# Les vraies valeurs vont dans .env.local, jamais dans ce fichier.
GITHUB_TOKEN=
LEAK_LOOKUP_API_KEY=
GRAVATAR_API_KEY=
