# Copier ce fichier en .env.local et le compléter.
# Les fichiers .env* sont ignorés par Git, sauf celui-ci.
# Ne jamais préfixer une clé par NEXT_PUBLIC_ : elle serait envoyée au navigateur.
# Une source dont la clé est vide est sautée (voir docs/DECISIONS.md, T3).

# GitHub, optionnel : sans jeton, 60 appels par heure et 10 recherches par
# minute, partagés par tous les postes de la même adresse IP.
# Jeton « fine-grained » sans aucune permission (Public repositories seulement).
GITHUB_TOKEN=

# Tavily (recherche web) : sans clé, la source est sautée. Offre gratuite,
# 1000 recherches par mois, sans carte bancaire. À réserver aux portes
# ouvertes : chaque essai avec /dev consomme un crédit.
TAVILY_API_KEY=

# search.ch (annuaire, adresse et ville par téléphone, personnes par nom) : sans
# clé, la source est sautée. Clé gratuite pour un usage personnel ; la source
# doit être citée et l'usage aux portes ouvertes est à confirmer auprès de
# search.ch. Quota mensuel limité : essais avec /dev rares.
SEARCH_CH_API_KEY=
