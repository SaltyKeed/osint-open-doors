# Copy this file to .env.surface (or .env.deep) and fill in the values.
# Never commit these files: the repository is public, no real key may appear
# in a versioned file.

# Mode of the app: "surface" (legal public sources) or "deep" (D10).
APP_MODE=surface

# search.ch phone directory API (key requested on search.ch/tel/api/getkey.fr.html)
SEARCH_CH_API_KEY=

# Tavily web search API (free plan, app.tavily.com)
TAVILY_API_KEY=

# Optional GitHub token (read-only, no scope): raises the search limit from
# 10 to 30 requests per minute. github.com/settings/tokens
GITHUB_TOKEN=
